<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <changeSet id="20250331-1652-create-table-questions" author="tuna">
        <createTable tableName="questions">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="content" type="varchar"/>
            <column name="media_link" type="varchar"/>
            <column name="fun_fact" type="varchar"/>
            <column name="quiz_id" type="bigint"/>

            <column name="created_by" type="bigint"/>
            <column name="created_at" type="bigint"/>
            <column name="last_updated_by" type="bigint"/>
            <column name="last_updated_at"  type="bigint"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="questions"
                baseColumnNames="quiz_id"
                constraintName="fk_question_quiz"
                referencedTableName="quizzes"
                referencedColumnNames="id"/>
    </changeSet>
    
    <changeSet id="20250403-add-column-time" author="tuna">
        <addColumn tableName="quizzes">
            <column name="time" type="int"/>
        </addColumn>
    </changeSet>

    <changeSet id="20250403-drop-column-time" author="tuna">
        <dropColumn tableName="quizzes">
            <column name="time" type="int"/>
        </dropColumn>
    </changeSet>

    <changeSet id="20250403-add-column-time-to-questions" author="tuna">
        <addColumn tableName="questions">
            <column name="time" type="int"/>
        </addColumn>
    </changeSet>

    <changeSet id="20250406-2238-add-column-order" author="tuna">
        <addColumn tableName="questions">
            <column name="order" type="int"/>
        </addColumn>
    </changeSet>

    <changeSet id="20250407-1542-rename-column-order" author="tuna">
        <renameColumn tableName="questions" oldColumnName="order" newColumnName="question_order"/>
    </changeSet>

    <changeSet id="20250422-1532-drop-column-media-link-in-table-questions" author="tuna">
        <dropColumn tableName="questions" columnName="media_link"/>
    </changeSet>

    <changeSet id="20250422-1532-add-column-media-id-in-table-questions" author="tuna">
        <addColumn tableName="questions">
            <column name="media_id" type="bigint"/>
        </addColumn>
    </changeSet>

    <changeSet id="20250422-1532-add-fk-to-table-medias" author="tuna">
        <addForeignKeyConstraint
                baseTableName="questions"
                baseColumnNames="media_id"
                constraintName="fk_quiz_media"
                referencedTableName="medias"
                referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>