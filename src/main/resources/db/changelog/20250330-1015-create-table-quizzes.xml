<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <changeSet id="20250330-1015-create-table-quizzes" author="tuna">
        <createTable tableName="quizzes">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>

            <column name="title" type="varchar(255)"/>
            <column name="description" type="varchar"/>
            <column name="media_link" type="varchar"/>
            <column name="modifier" type="int"/>
            <column name="rating" type="double"/>
            <column name="user_id" type="bigint"/>

            <column name="created_by" type="varchar"/>
            <column name="created_at" type="bigint"/>
            <column name="last_updated_by" type="varchar"/>
            <column name="last_updated_at"  type="bigint"/>
        </createTable>
        
        <addForeignKeyConstraint
                baseTableName="quizzes"
                baseColumnNames="user_id"
                constraintName="fk_quizzes_user"
                referencedTableName="users"
                referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>