<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <changeSet id="20250421-1000-create-table-quiz-sessions" author="hieuta">
        <createTable tableName="quiz_sessions">
            <column name="id" type="integer" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="quiz_id" type="integer"/>
            <column name="session_code" type="varchar(50)"/>
            <column name="status" type="varchar(255)"/>
            <column name="current_question_id" type="integer"/>
            <column name="start_time" type="bigint"/>
            <column name="end_time" type="bigint"/>
            <column name="created_by" type="bigint"/>
            <column name="created_at" type="bigint"/>
            <column name="last_updated_by" type="bigint"/>
            <column name="last_updated_at" type="bigint"/>
        </createTable>
    </changeSet>

    <changeSet id="20250422-1000-update-quiz-sessions" author="hieuta">
        <addColumn tableName="quiz_sessions">
            <column name="duration" type="bigint" defaultValue="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <dropColumn tableName="quiz_sessions" columnName="end_time"/>
    </changeSet>
</databaseChangeLog>