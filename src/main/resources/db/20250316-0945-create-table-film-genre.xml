<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <changeSet id="20250316-0945-create-table-film-genre" author="tuna">
        <createTable tableName="film_genre">
            <column name="id" type="integer" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="film_id" type="integer"/>
            <column name="genre_id" type="integer"/>

            <column name="created_by" type="varchar"/>
            <column name="created_at" type="bigint"/>
            <column name="last_updated_by" type="varchar"/>
            <column name="last_updated_at"  type="bigint"/>
        </createTable>
        
        <addForeignKeyConstraint
                baseTableName="film_genre"
                baseColumnNames="film_id"
                constraintName="fk_film_film_genre"
                referencedTableName="films"
                referencedColumnNames="id"/>

        <addForeignKeyConstraint
                baseTableName="film_genre"
                baseColumnNames="genre_id"
                constraintName="fk_genre_film_genre"
                referencedTableName="genres"
                referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>